/**
  返回顶部按钮样式
*/

.back-to-top {
  position: fixed;
  right: 30px;
  bottom: 30px;
  text-align: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  z-index: 999;
}

.back-to-top:hover {
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
}

.back-to-top.show {
  opacity: 1;
  visibility: visible;
}