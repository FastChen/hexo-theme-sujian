<% var last; %>
<% page.posts.each(function(post, i){ %>
    <% const year = post.date.year(); %>

    <% if (last != year){ %>
    <% last = year; %>
        <h2>
            <a href="<%- url_for(config.archive_dir + '/' + year) %>" class="archive-year"><%= year %></a>
        </h2>
    <% } %>

    <ul class="list-group list-group-flush">
        <!-- <li class="list-group-item"><a class="" href="<%- url_for(post.link) %>" target="_blank"><%= post.title %></a></li> -->
        <li class="list-group-item">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      <span title="<%= date_xml(post.date) %>"><%= date(post.date) %></span>
    </li>
    </ul>
<% }) %>

<%- partial('_partial/pagination', {baseURL: config.archive_dir}) %>