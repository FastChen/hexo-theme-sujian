<div class="dropdown">
    <button class="btn btn-link nav-link dropdown-toggle" type="button" id="themeDropdown" data-bs-toggle="dropdown" aria-expanded="false"></button>
    
    <ul class="dropdown-menu p-2 rounded-3 mx-0 border-0 shadow" aria-labelledby="themeDropdown">
        <li>
            <a class="dropdown-item rounded-2 theme-option" href="#" data-theme="light">
                <i class="me-2 opacity-50 bi bi-sun-fill"></i>
                <%= __('theme.light') %>
            </a>
        </li>
        <li>
            <a class="dropdown-item rounded-2 theme-option" href="#" data-theme="dark">
                <i class="me-2 opacity-50 bi bi-moon-stars-fill"></i>
                <%= __('theme.dark') %>
            </a>
        </li>
        <li>
            <hr class="dropdown-divider">
        </li>
        <li>
            <a class="dropdown-item rounded-2 theme-option active" href="#" data-theme="auto">
                <i class="me-2 opacity-50 bi bi-brilliance"></i>
                <%= __('theme.auto') %>
            </a>
        </li>
    </ul>
</div>

<%- js('js/utils/theme') %>