<% if (theme.back_to_top.enable) { %>
<!-- 右下角浮动工具栏 -->
<div class="position-fixed bottom-0 end-0" style="margin-right: 30px;margin-bottom: 30px;z-index: 1050;">
  <div class="d-flex flex-column align-items-center gap-2">
    <% if (page.content && toc(page.content).length > 0) { %>
    <!-- TOC 按钮 + 向上弹出卡片（用 dropup 包裹） -->
    <div class="btn-group dropup" id="toc-group">
      <a class="btn btn-secondary rounded"
         data-bs-toggle="dropdown"
         aria-expanded="false"
         title="<%= __('toc') %>">
        <i class="bi bi-list-ul"></i>
      </a>
      <div class="dropdown-menu dropdown-menu-end text-nowrap p-3 mb-2 border-0 shadow"
           style="max-height: 70vh; width: auto; overflow-y: auto;">
        <%- toc(page.content, {
          'class_link': 'link-body-emphasis text-decoration-none',
          // 'list_number': false,
          }) %>
      </div>
    </div>
    <% } %>

    <!-- 返回顶部按钮（默认隐藏，滚动后出现） -->
    <a href="#"
       id="back-to-top"
       class="btn btn-secondary d-none"
       title="<%= __('back_to_top') %>">
      <i class="bi bi-arrow-up"></i>
    </a>

  </div>
</div>

<%- js('js/utils/back-to-top') %>
<% } %>

