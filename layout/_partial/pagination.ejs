<%# 分页功能 %>
<% if (!page.total || page.total <= 1) return; %>

<nav class="mt-5">
  <ul class="pagination">
    <% if (page.prev) { %>
    <li class="page-item">
      <a class="page-link" href="<%= url_for(page.prev_link) %>" aria-label="Previous" rel="prev">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
    <% } %>

    <% for (var i = 1; i <= page.total; i++) { %>
      <% const navactive = page.current == i ? ' active' : '' %>
      <li class="page-item<%= navactive %>">
        <% if (i === 1) { %>
          <a class="page-link" href="<%= url_for(baseURL + '/') %>"><%= i %></a>
        <% } else { %>
          <a class="page-link" href="<%= url_for(baseURL + '/' + config.pagination_dir + '/' + i) %>"><%= i %></a>
        <% } %>
      </li>
    <% } %>
    
    <% if (page.next) { %>
    <li class="page-item">
      <a class="page-link" href="<%= url_for(page.next_link) %>" aria-label="Next" rel="next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
    <% } %>
  </ul>
</nav>