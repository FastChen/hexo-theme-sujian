<%# 标签渲染，是否在首页显示或非首页显示 %>
<% if (theme.tags.show_tags_index || !index){ %>
    <% if (post.tags && post.tags.length){ %>
        <% post.tags.each(function(tag){ %>
            <a href="<%- url_for(tag.path) %>" class="text-decoration-none">
                <div class="btn btn-secondary rounded-pill shadow-sm">
                    <%= theme.tags.prefix %><%= tag.name %><%= theme.tags.suffix %>
                    <span class="badge text-bg-light rounded-pill ms-1"><%= tag.length %></span>
                </div>
            </a>
        <% }) %>
    <% } %>
<% } %>