<%- partial('_partial/page/title', { title: page.title, subtitle: _p('tags.total_count', site.tags.length) }) %>

<!-- 标签列表 -->
<div class="d-flex flex-wrap justify-content-center gap-2">
  <% site.tags.each(function(tag) { %>
  <a href="<%- url_for(tag.path) %>" class="text-decoration-none">
    <div class="btn btn-secondary rounded-pill shadow-sm">
      <%= tag.name %>
      <span class="badge text-bg-light rounded-pill ms-1"><%= tag.length %></span>
    </div>
  </a>
  <% }) %>
</div>

<!-- 无标签时的提示 -->
<% if (site.tags.length === 0) { %>
  <div class="alert alert-secondary d-flex gap-2" role="alert">
    <i class="bi bi-info-square-fill"></i>
    <span>暂无标签，快去写文章并添加标签吧～</span>
  </div>
<% } %>